<resources>
    <style name="Theme.PLaMo.Home" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0B57D0</item>
        <item name="android:statusBarColor">#F7F9FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F7F9FC</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F7F9FC</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.PLaMo.Floating" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#0B57D0</item>
    </style>
</resources>
